# ── Core ─────────────────────────────────────────────────────────────
# Postgres connection string (required)
DATABASE_URL=postgres://junex:CHANGE_ME@127.0.0.1:5432/junex

# Port the API server listens on (required — the process refuses to start without it)
PORT=8080
# Bind address (defaults to 0.0.0.0 in production)
HOST=0.0.0.0
NODE_ENV=production

# Session/JWT signing secret (required in production — use `openssl rand -hex 32`)
SESSION_SECRET=

# ── URLs (used for OAuth callbacks + payment redirects) ──────────────
# Public URL of this server, no trailing slash
BACKEND_URL=https://yourdomain.com
# Public URL of the frontend (same server by default)
FRONTEND_URL=https://yourdomain.com

# ── Payments (Paystack) ─────────────────────────────────────────────
# Secret key from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=

# ── OAuth (optional — login works with email/password without these) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
